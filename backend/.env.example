# Private backend only. Never commit real values.
EWMI_API_TOKEN=replace-with-a-long-random-api-token
EWMI_WEBHOOK_SECRET=replace-with-a-different-long-random-webhook-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EWMI_DB_PATH=ewmi.sqlite3
EWMI_ALLOWED_ORIGINS=https://emawright.github.io,http://localhost:5500,http://127.0.0.1:5500

# Optional broker-specific MT5 terminal paths and symbol mappings.
# Log in using each broker's official MT5 terminal. Never place passwords here.
# JSON example (escape Windows backslashes as double backslashes):
# EWMI_BROKER_PROFILES_JSON={"Exness":{"terminal_path":"C:\\Program Files\\Exness MT5\\terminal64.exe","symbols":{"EURUSD":"EURUSD","GBPUSD":"GBPUSD","XAUUSD":"XAUUSD"}},"Deriv":{"terminal_path":"C:\\Program Files\\Deriv MT5\\terminal64.exe","symbols":{"EURUSD":"EURUSD","GBPUSD":"GBPUSD","XAUUSD":"XAUUSD"}}}

# Optional SMTP delivery (daily 07:00 EAT and weekly Sunday 07:00 EAT)
EWMI_SMTP_HOST=
EWMI_SMTP_PORT=465
EWMI_SMTP_USER=
EWMI_SMTP_PASSWORD=
EWMI_REPORT_EMAIL_FROM=
EWMI_REPORT_EMAIL_TO=
